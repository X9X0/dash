# =============================================================================
# Dash Server Configuration
# Copy this file to .env and customize for your environment
# =============================================================================

# Server port
PORT=3001

# Database URL (SQLite)
# For development: file:./dev.db
# For production: file:/path/to/data/dash.db
DATABASE_URL=file:./dev.db

# JWT Secret for authentication
# Generate with: openssl rand -base64 32
# REQUIRED in production: the server refuses to start with this placeholder.
# In development a random secret is used (and every login is invalidated on restart).
JWT_SECRET=change-this-to-a-random-secret-key

# Node environment (development | production)
NODE_ENV=development

# =============================================================================
# User registration
# =============================================================================
# The first account ever registered becomes admin. Every later self-registered
# account gets REGISTRATION_ROLE (viewer = read-only; operator = can claim
# machines, control prints, log maintenance). Admins can promote users on the
# Users page, or create accounts directly.
# REGISTRATION_ROLE=viewer
#
# Set to false to disable self sign-up entirely (admins create accounts instead).
# ALLOW_REGISTRATION=true

# =============================================================================
# Optional: Email notifications (nodemailer)
# Powers "Email when offline" machine alerts. If SMTP_HOST/SMTP_USER/SMTP_PASS
# are unset, email is silently disabled (in-app notifications still work).
# =============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Dash <your-email@gmail.com>

# =============================================================================
# Optional: Slack notifications
# =============================================================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# =============================================================================
# Data directory (uploads + backups)
# =============================================================================
# Uploaded photos/attachments are stored in DASH_DATA_DIR/uploads, which is the
# directory scripts/backup.sh archives. The deploy/update scripts set this for
# you. If unset, uploads fall back to ./uploads (or ./server/uploads) relative
# to the working directory, which is NOT covered by backups.
# DASH_DATA_DIR=/opt/dash/data
#
# Override just the uploads location (takes precedence over DASH_DATA_DIR):
# UPLOADS_DIR=/mnt/storage/dash-uploads

# =============================================================================
# Reverse Proxy Configuration (nginx)
# =============================================================================
# When running behind nginx or another reverse proxy:
# - Keep PORT=3001 (nginx proxies to this port)
# - No server code changes needed; nginx handles port 80/443 traffic
#
# For HTTPS deployments with nginx + Let's Encrypt:
# - Run: sudo certbot --nginx -d yourdomain.com
# - Certbot will configure nginx automatically
# - The Node.js server continues running on HTTP (port 3001)
# - nginx terminates SSL and proxies to the backend

# =============================================================================
# Optional: BamBuddy Integration (Bambu Lab 3D printer management)
# =============================================================================
# URL where BamBuddy API is accessible from the server (internal)
# BAMBUDDY_URL=http://localhost:8000
#
# BamBuddy API key (generate in BamBuddy → Settings → API Keys)
# BAMBUDDY_API_KEY=bb_your-api-key-here
#
# Public URL for BamBuddy (used for external links in the browser)
# BAMBUDDY_PUBLIC_URL=http://dash.lab:8000
